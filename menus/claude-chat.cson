'context-menu':
  '.claude-chat .message-content': [
    {
      label: 'Copy'
      command: 'claude-chat:copy'
    }
    {
      label: 'Copy Message'
      command: 'claude-chat:copy-message'
    }
  ]
  '.claude-chat .tool-content': [
    {
      label: 'Copy'
      command: 'claude-chat:copy'
    }
    {
      label: 'Copy Content'
      command: 'claude-chat:copy-message'
    }
  ]

'menu': [
  {
    label: 'Packages'
    submenu: [
      {
        label: 'Claude Chat'
        submenu: [
          { label: 'Open', command: 'claude-chat:open' }
          { label: 'Toggle', command: 'claude-chat:toggle' }
          { label: 'New Chat', command: 'claude-chat:new-chat' }
          { label: 'New Worktree Session', command: 'claude-chat:new-worktree-session' }
          { label: 'Fork Session', command: 'claude-chat:fork-session' }
          { label: 'Open Latest', command: 'claude-chat:open-latest' }
          { label: 'Check CLI', command: 'claude-chat:check-cli' }
          { label: 'Update CLI', command: 'claude-chat:update-cli' }
          { label: 'Settings', command: 'claude-chat:settings' }
        ]
      }
    ]
  }
]
