{
  "name": "claude-chat",
  "main": "./lib/main",
  "version": "0.14.0",
  "description": "Interactive chat panel for Claude Code",
  "keywords": [
    "claude",
    "ai",
    "chat",
    "assistant"
  ],
  "repository": "https://github.com/asiloisad/pulsar-claude-chat",
  "license": "MIT",
  "engines": {
    "atom": ">=1.100.0 <2.0.0"
  },
  "dependencies": {
    "@asiloisad/select-list": "^1.5.0",
    "@mathjax/src": "^4.0.0",
    "@preact/signals": "^2.9.0",
    "preact": "^10.29.0"
  },
  "activationCommands": {
    "atom-workspace": [
      "claude-chat:open",
      "claude-chat:open-latest",
      "claude-chat:toggle",
      "claude-chat:new-chat",
      "claude-chat:settings",
      "claude-chat:history",
      "claude-chat:clear-history"
    ],
    "atom-text-editor:not([mini])": [
      "editor:attach-to-claude"
    ],
    ".tree-view": [
      "tree-view:attach-to-claude"
    ]
  },
  "providedServices": {
    "claude-chat": {
      "versions": {
        "1.0.0": "provideService"
      }
    }
  },
  "consumedServices": {
    "pulsar-mcp": {
      "versions": {
        "^1.0.0": "consumePulsarMcp"
      }
    },
    "tree-view": {
      "versions": {
        "^1.0.0": "consumeTreeView"
      }
    }
  },
  "configSchema": {
    "claudePath": {
      "title": "Claude CLI Path",
      "description": "Path to Claude CLI executable",
      "type": "string",
      "default": "claude",
      "order": 0
    },
    "panelPosition": {
      "title": "Panel Position",
      "description": "Default position for the chat panel",
      "type": "string",
      "default": "right",
      "enum": [
        "right",
        "left"
      ],
      "order": 1
    },
    "model": {
      "title": "Model",
      "description": "Claude model to use",
      "type": "string",
      "default": "default",
      "enum": [
        "default",
        "sonnet",
        "opus",
        "haiku",
        "custom"
      ],
      "order": 2
    },
    "customModel": {
      "title": "Custom Model",
      "description": "Model name when 'custom' is selected (e.g. qwen3-coder, gpt-4o)",
      "type": "string",
      "default": "",
      "order": 3
    },
    "customBaseUrl": {
      "title": "Custom API Base URL",
      "description": "Override the API endpoint (e.g. http://localhost:11434 for Ollama, or any OpenAI-compatible URL)",
      "type": "string",
      "default": "",
      "order": 4
    },
    "permissionMode": {
      "title": "Permission Mode",
      "description": "How to handle permission requests",
      "type": "string",
      "default": "default",
      "enum": [
        {
          "value": "default",
          "description": "Prompt for dangerous operations"
        },
        {
          "value": "plan",
          "description": "Read-only mode"
        },
        {
          "value": "acceptEdits",
          "description": "Auto-accept file edits"
        },
        {
          "value": "bypassPermissions",
          "description": "Auto-accept all"
        }
      ],
      "order": 5
    },
    "effortMode": {
      "title": "Effort Mode",
      "description": "Default reasoning effort level",
      "type": "string",
      "default": "medium",
      "enum": [
        {
          "value": "low",
          "description": "Quick, less thorough responses"
        },
        {
          "value": "medium",
          "description": "Balanced effort"
        },
        {
          "value": "high",
          "description": "Thorough responses"
        }
      ],
      "order": 6
    },
    "streamingText": {
      "title": "Streaming Text",
      "description": "Show text as it streams in. When off, text appears only after the response is complete.",
      "type": "boolean",
      "default": true,
      "order": 7
    },
    "debugMode": {
      "title": "Debug Mode",
      "description": "Enable debug logging to console for troubleshooting",
      "type": "boolean",
      "default": false,
      "order": 99
    }
  }
}
